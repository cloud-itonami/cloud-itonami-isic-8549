;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a facility-safety monitoring robot supports
;; physical supervision during practical instruction in other education
;; (ISIC 8549: first-aid, safety and rope-access / work-at-height training
;; among others). Its physical work: checking the steel anchor rods that
;; trainees clip onto (the rod must not yield under the arrest load), and
;; carrying training manikins between the store and the training floor.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-8549"
 :cases
 [{:id :anchor-rod-proof
   :kind :material
   :procedure "tensile proof of the S235 steel anchor rod that work-at-height trainees clip onto"
   :params {:length-m 0.20 :youngs-modulus-pa 210.0e9 :yield-stress-pa 235.0e6
            :hardening-pa 1.0e9 :density-kg-m3 7850.0 :max-force-n 30000.0}
   :sweep {:param :area-m2 :values [3.0e-5 4.0e-5 5.0e-5 7.0e-5 9.0e-5]}
   :quantity :yield-force-n
   :limit {:min 12000.0 :basis "estimate: 12 kN static strength, the figure commonly quoted for EN 795 anchor devices (clause to be pinned before this loses 'estimate')"}
   :boundary {:lo 2.0e-5 :hi 1.2e-4}}
  {:id :manikin-trolley-run
   :kind :transport
   :procedure "robot carries a trolley of CPR training manikins from the store to the training floor"
   :params {:mass-kg 40.0 :distance-m 60.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 90.0 :crr 0.03
            :cog-height-m 0.45 :support-half-length-m 0.30 :max-time-s 3000.0}
   :sweep {:param :payload-kg :values [10.0 20.0 40.0 60.0 80.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: store-to-floor leg within the 5-minute changeover between training sessions, allowing for doors"}
   :boundary {:lo 5.0 :hi 250.0}}]}
